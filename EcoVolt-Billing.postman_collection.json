{
  "info": {
    "_postman_id": "a64ebf25-7d8d-45f8-9af7-ecovolt-billing",
    "name": "EcoVolt Billing",
    "description": "Comprehensive API collection for billing-service. Includes domain CRUD/read APIs, end-to-end billing workflow, negative tests, and CI Newman command.\n\nNewman CI command:\nnewman run EcoVolt-Billing.postman_collection.json -e EcoVolt-Billing.postman_environment.json --bail --reporters cli,junit --reporter-junit-export build/newman/ecovolt-billing-results.xml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "customerId", "value": "" },
    { "key": "meterId", "value": "" },
    { "key": "readingId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "tariffId", "value": "" },
    { "key": "tariffVersion", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "duplicateMeterNumber", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer {{$timestamp}}\",\n  \"email\": \"postman.customer.{{runId}}@ecovolt.test\",\n  \"phone\": \"+15550001001\",\n  \"address\": \"100 Workflow Avenue\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Customer schema is valid', () => pm.response.to.have.jsonSchema({type:'object',required:['id','customerNumber','name','email','status','createdAt','updatedAt'],properties:{id:{type:'number'},customerNumber:{type:'string'},name:{type:'string'},email:{type:'string'},phone:{type:['string','null']},address:{type:['string','null']},status:{type:'string'},createdAt:{type:'string'},updatedAt:{type:'string'}}}));",
                  "pm.test('Business rule: new customers are ACTIVE', () => pm.expect(json.status).to.eql('ACTIVE'));",
                  "pm.test('Business rule: customer number is generated', () => pm.expect(json.customerNumber).to.match(/^CUST-[A-Z0-9-]+/));",
                  "pm.collectionVariables.set('customerId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Customer",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/{{customerId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Customer response schema is valid', () => pm.response.to.have.jsonSchema({type:'object',required:['id','customerNumber','name','email','status'],properties:{id:{type:'number'},customerNumber:{type:'string'},name:{type:'string'},email:{type:'string'},status:{enum:['ACTIVE','INACTIVE']}}}));",
                  "pm.test('Returned customer matches stored customerId', () => pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('customerId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers?page=0&size=20&sort=id,asc" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Page schema is valid', () => pm.response.to.have.jsonSchema({type:'object',required:['content','pageable','totalElements','totalPages','size','number'],properties:{content:{type:'array'},totalElements:{type:'number'},totalPages:{type:'number'},size:{type:'number'},number:{type:'number'}}}));",
                  "pm.test('Pagination request page and size are honored', () => { pm.expect(json.number).to.eql(0); pm.expect(json.size).to.eql(20); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Customer {{$timestamp}}\",\n  \"email\": \"postman.customer.updated.{{runId}}@ecovolt.test\",\n  \"phone\": \"+15550001002\",\n  \"address\": \"200 Workflow Avenue\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Updated customer keeps same id', () => pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('customerId'))));",
                  "pm.test('Business rule: update does not deactivate customer', () => pm.expect(json.status).to.eql('ACTIVE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate Customer",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/customers/{{customerId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('No response body is returned', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
    },
