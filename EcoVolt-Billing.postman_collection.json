    {
      "name": "Tariff",
      "item": [
        {
          "name": "Create Tariff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RESIDENTIAL\",\n  \"version\": {{tariffVersion}},\n  \"name\": \"Postman Historical Residential {{tariffVersion}}\",\n  \"effectiveFrom\": \"2023-01-01\",\n  \"effectiveTo\": \"2023-12-31\",\n  \"slabs\": [\n    { \"fromUnits\": 0.00, \"toUnits\": 100.00, \"ratePerUnit\": 4.00 },\n    { \"fromUnits\": 100.00, \"toUnits\": null, \"ratePerUnit\": 6.00 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/tariff-plans"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('tariffVersion', Math.floor(Math.random() * 900000) + 10000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Tariff schema is valid', () => pm.expect(json).to.include.keys(['id','type','version','name','effectiveFrom','effectiveTo','active','slabs']));",
                  "pm.test('Business rule: tariff slabs are returned', () => pm.expect(json.slabs).to.be.an('array').that.is.not.empty);",
                  "pm.test('Business rule: created tariff uses requested version', () => pm.expect(json.version).to.eql(Number(pm.collectionVariables.get('tariffVersion'))));",
                  "pm.collectionVariables.set('tariffId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Tariff",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tariff-plans/{{tariffId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returned tariff matches stored tariffId', () => pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('tariffId'))));",
                  "pm.test('Tariff detail includes slabs', () => pm.expect(json.slabs).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate Tariff",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/tariff-plans/{{tariffId}}/deactivate?effectiveTo=2023-12-31" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Lifecycle transition: tariff becomes inactive', () => pm.expect(json.active).to.eql(false));",
                  "pm.test('Deactivated historical tariff keeps same id', () => pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('tariffId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tariffs",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tariff-plans?page=0&size=20&sort=id,asc" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Pagination metadata exists', () => { pm.expect(json.content).to.be.an('array'); pm.expect(json.number).to.eql(0); });",
                  "if (!pm.collectionVariables.get('tariffId') && json.content.length) { pm.collectionVariables.set('tariffId', json.content[0].id); }"
                ]
              }
            }
          ]
        }
      ]
