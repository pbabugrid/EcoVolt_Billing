    {
      "name": "End-to-End Workflow",
      "description": "Run the domain folders in order or run this folder after environment reset: Create Customer -> Create Meter -> Create Readings -> Generate Invoice -> Get Invoice -> Pay Invoice -> Verify PAID.",
      "item": [
        { "name": "01 Create Customer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"E2E Customer {{runId}}\",\n  \"email\": \"e2e.customer.{{runId}}@ecovolt.test\",\n  \"phone\": \"+15550002001\",\n  \"address\": \"1 E2E Way\"\n}" }, "url": "{{baseUrl}}/api/customers" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.test('E2E customer is ACTIVE', () => pm.expect(json.status).to.eql('ACTIVE'));", "pm.collectionVariables.set('customerId', json.id);"] } }] },
        { "name": "02 Create Meter", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"customerId\": {{customerId}},\n  \"meterNumber\": \"MTR-E2E-{{runId}}\",\n  \"installationDate\": \"2024-01-01\",\n  \"tariffType\": \"RESIDENTIAL\"\n}" }, "url": "{{baseUrl}}/api/meters" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.test('E2E meter belongs to customer', () => pm.expect(json.customerId).to.eql(Number(pm.collectionVariables.get('customerId'))));", "pm.collectionVariables.set('meterId', json.id);"] } }] },
        { "name": "03 Create Previous Reading", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"meterId\": {{meterId}},\n  \"readingDate\": \"2024-06-01\",\n  \"readingValue\": 200.00\n}" }, "url": "{{baseUrl}}/api/readings" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('readingId', json.id);"] } }] },
        { "name": "04 Create Current Reading", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"meterId\": {{meterId}},\n  \"readingDate\": \"2024-07-01\",\n  \"readingValue\": 260.00\n}" }, "url": "{{baseUrl}}/api/readings" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('readingId', json.id);"] } }] },
        { "name": "05 Generate Invoice", "request": { "method": "POST", "url": "{{baseUrl}}/api/invoices/generate/{{customerId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.test('E2E invoice generated', () => pm.expect(json).to.be.an('array').that.is.not.empty);", "pm.collectionVariables.set('invoiceId', json[0].id);", "pm.test('Generated status is correct', () => pm.expect(json[0].status).to.eql('GENERATED'));"] } }] },
        { "name": "06 Get Invoice", "request": { "method": "GET", "url": "{{baseUrl}}/api/invoices/{{invoiceId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('E2E get invoice matches id', () => pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('invoiceId'))));"] } }] },
        { "name": "07 Pay Invoice", "request": { "method": "POST", "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/pay" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('Verify Status = PAID', () => pm.expect(json.status).to.eql('PAID'));"] } }] }
      ]
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "Duplicate Customer - Current API Feasibility",
          "description": "The public Customer API does not accept customerNumber and does not enforce unique email, so deterministic duplicate-customer rejection is not feasible. This request documents current behavior with a duplicate email.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Duplicate Email Customer\",\n  \"email\": \"postman.customer.updated.{{runId}}@ecovolt.test\",\n  \"phone\": \"+15550001003\",\n  \"address\": \"Duplicate feasibility\"\n}" },
            "url": "{{baseUrl}}/api/customers"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current behavior: duplicate email is accepted because customerNumber is server-generated', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.test('Feasibility note: this is not a true duplicate-customer error path', () => pm.expect(json.customerNumber).to.match(/^CUST-/));"] } }]
        },
        {
          "name": "Duplicate Meter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": {{customerId}},\n  \"meterNumber\": \"{{duplicateMeterNumber}}\",\n  \"installationDate\": \"2024-01-01\",\n  \"tariffType\": \"RESIDENTIAL\"\n}" },
            "url": "{{baseUrl}}/api/meters"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 422 Unprocessable Entity', () => pm.response.to.have.status(422));", "const json = pm.response.json();", "pm.test('Duplicate meter returns ApiError', () => pm.expect(json).to.include.keys(['status','error','message','path']));", "pm.test('Business rule: meter number already exists', () => pm.expect(json.message).to.include('Meter number already exists'));"] } }]
        },
        {
          "name": "Invalid Invoice Transition",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/invoices/{{invoiceId}}/pay" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 422 for terminal invoice', () => pm.response.to.have.status(422));", "const json = pm.response.json();", "pm.test('Lifecycle transition validation error is structured', () => pm.expect(json.status).to.eql(422));"] } }]
        },
        {
          "name": "Missing Entity 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/999999999" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 404 Not Found', () => pm.response.to.have.status(404));", "const json = pm.response.json();", "pm.test('404 ApiError schema is valid', () => pm.expect(json).to.include.keys(['timestamp','status','error','message','path']));", "pm.test('Missing entity error identifies Customer', () => pm.expect(json.message).to.include('Customer'));"] } }]
        },
        {
          "name": "Validation Errors 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"x\",\n  \"address\": \"Validation test\"\n}" },
            "url": "{{baseUrl}}/api/customers"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 400 Bad Request', () => pm.response.to.have.status(400));", "const json = pm.response.json();", "pm.test('Validation ApiError contains fieldErrors', () => { pm.expect(json.status).to.eql(400); pm.expect(json.fieldErrors).to.be.an('object'); });", "pm.test('Validation errors include name and email', () => { pm.expect(json.fieldErrors).to.have.property('name'); pm.expect(json.fieldErrors).to.have.property('email'); });"] } }]
        },
        {
          "name": "Optimistic Lock Conflict - Feasibility Note",
          "description": "Optimistic locking is implemented server-side and mapped to 409, but public REST DTOs do not expose opt_lock/version fields, so a deterministic stale-write conflict cannot be triggered from this collection without a test-only probe endpoint or direct database access.",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/{{customerId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 OK feasibility probe', () => pm.response.to.have.status(200));", "pm.test('Optimistic lock conflict is not publicly reproducible through current DTO contract', () => pm.expect(true).to.eql(true));"] } }]
        }
      ]
    }
  ]
}
