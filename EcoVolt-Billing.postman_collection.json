          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Generate returns invoice array', () => pm.expect(json).to.be.an('array').that.is.not.empty);",
                  "const invoice = json[0];",
                  "pm.test('Invoice schema is valid', () => pm.expect(invoice).to.include.keys(['id','invoiceNumber','customerId','previousReadingId','currentReadingId','unitsConsumed','amount','generatedDate','status']));",
                  "pm.test('Business rule: generated invoice is GENERATED', () => pm.expect(invoice.status).to.eql('GENERATED'));",
                  "pm.test('Business rule: consumption is positive', () => pm.expect(invoice.unitsConsumed).to.be.above(0));",
                  "pm.collectionVariables.set('invoiceId', invoice.id);"
